# Supabase Configuration
# Get these from your Supabase project: Settings > API.
# Prefer the current publishable key format (sb_publishable_...) when available.

VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key

# Optional temporary frontend-only hold for trainer pages.
# If both values are set, trainer routes require this username + passcode once per browser session.
# These values are bundled into the client and are not strong secrets.
VITE_TRAINER_ACCESS_USERNAME=
VITE_TRAINER_ACCESS_PASSCODE=

# Optional public base URL used for shared workout links.
VITE_SHARE_BASE_URL=

# Native (Capacitor) builds
# Deployed web origin, for example https://fitwizard.app (decision L3). The native
# app has no /api of its own, so apiUrl() (src/lib/apiBase.ts) sends API calls here.
# Leave empty for web-only builds.
VITE_PUBLIC_APP_ORIGIN=

# Feature flags (src/lib/featureFlags.ts). Off by default: v1 ships for lifters only.
# Set to "true" to show Circles (social groups) or the coach portal.
VITE_FEATURE_CIRCLES=false
VITE_FEATURE_COACH=false

# Monitoring (Lane C). Public values; leave empty to turn the tool off.
# Sentry crash reporting: runs only when this is set AND the user opted in.
VITE_SENTRY_DSN=

# Server-only configuration (the Vercel functions in api/)
# Comma-separated list of allowed origins for CORS. On Vercel, set the production
# and beta origins here; the deployment's own URLs, capacitor://localhost and
# https://localhost are always allowed by api/_lib/guard.ts.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Server-only API Ninjas key for /api/motivation-quote. Do not prefix with VITE_.
API_NINJAS_API_KEY=
